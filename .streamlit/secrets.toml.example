# Template for Streamlit Community Cloud.
# Paste this into: your app -> Settings -> Secrets, with real values filled in.
# NEVER commit the real secrets.toml - only this example file belongs in git.

APP_PASSWORD = "pick-a-strong-team-password"

# Supabase. Use the SERVICE ROLE key, not the publishable one: once RLS is enabled,
# the publishable key is blocked by design. Streamlit runs Python server-side, so this
# key is never sent to the browser.
SUPABASE_URL = "https://rkhcbvssmfxoajqvsqma.supabase.co"
SUPABASE_KEY = "eyJ...service-role-key..."

# Model provider: "nvidia" (free) or "claude"
GROWMATED_PROVIDER = "nvidia"
NVIDIA_API_KEY = "nvapi-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
