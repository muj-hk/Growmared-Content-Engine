# Template for Streamlit Community Cloud.
# Paste into: your app -> Settings -> Secrets, replacing every REPLACE_ME with a real value.
# NEVER commit the real secrets.toml - only this example file belongs in git.
#
# IMPORTANT: anything below reading REPLACE_ME is a placeholder, not a value. Real keys
# contain no "..." and are never abbreviated. Copy them in full from C:\growmated-engine\.env
# or from the provider's dashboard.
#
# Expected shapes, so you can tell a whole key from a truncated one:
#   APP_PASSWORD        any string you choose
#   SUPABASE_URL        https://<project-ref>.supabase.co    (the only value with dots in it)
#   SUPABASE_KEY        service_role JWT, ~200+ chars, three parts separated by real dots
#                       (a JWT genuinely contains dots - those are part of the key)
#                       or the publishable key, ~46 chars, no dots
#   ANTHROPIC_API_KEY   sk-ant-api03-... 108 chars, no dots
#   NVIDIA_API_KEY      nvapi-... 70 chars, no dots

APP_PASSWORD = "REPLACE_ME_with_a_strong_team_password"

SUPABASE_URL = "https://rkhcbvssmfxoajqvsqma.supabase.co"
# Use the SERVICE ROLE key once RLS is enabled: the publishable key is blocked by design.
# Streamlit runs Python server-side, so this key never reaches the browser.
SUPABASE_KEY = "REPLACE_ME_with_the_full_supabase_key"

# "claude" (paid, reliable) or "nvidia" (free, currently unreliable)
GROWMATED_PROVIDER = "claude"
ANTHROPIC_API_KEY = "REPLACE_ME_with_the_full_anthropic_key"
# NVIDIA_API_KEY = "REPLACE_ME_only_if_using_the_nvidia_provider"
